# === API Keys ===
# Only fill in keys for engines you want to use.
# Missing keys = those engines are automatically skipped (no errors).

# Zhipu AI (智谱) — Get key at https://open.bigmodel.cn/
ZHIPU_API_KEY=

# Z.AI — Get key at https://z.ai/
ZAI_API_KEY=

# Alibaba Bailian (百炼) — Get key at https://bailian.console.aliyun.com/
BAILIAN_API_KEY=

# AMiner — Get key at https://apiv2.aminer.cn/
AMINER_API_KEY=

# Tavily Search API (authenticated channel; separate from keyless Tavily)
TAVILY_API_KEY=

# SerpBase Search API
SERPBASE_API_KEY=

# Exa Search API
EXA_API_KEY=

# Firecrawl Search API
FIRECRAWL_API_KEY=

# Brave Search API (separate from the keyless Brave web_fetch engine)
BRAVE_SEARCH_API_KEY=

# Baidu Qianfan AI Search
BAIDU_QIANFAN_API_KEY=

# Volcengine Doubao Search Custom API
DOUBAO_SEARCH_API_KEY=

# Zhihu (知乎) — Access secret for Zhihu API
ZHIHU_ACCESS_SECRET=

# OpenCLI path (optional, only if using browser-based engines)
# OPENCLI_PATH=opencli
