# === API Keys ===
# Only fill in keys for engines you want to use.
# Missing keys = those engines are automatically skipped (no errors).

# Zhipu AI (智谱) — Get key at https://open.bigmodel.cn/
ZHIPU_API_KEY=

# Z.AI — Get key at https://z.ai/
ZAI_API_KEY=

# Alibaba Bailian (百炼) — Get key at https://bailian.console.aliyun.com/
BAILIAN_API_KEY=

# AMiner — Get key at https://apiv2.aminer.cn/
AMINER_API_KEY=

# Zhihu (知乎) — Access secret for Zhihu API
ZHIHU_ACCESS_SECRET=

# OpenCLI path (optional, only if using browser-based engines)
# OPENCLI_PATH=opencli
